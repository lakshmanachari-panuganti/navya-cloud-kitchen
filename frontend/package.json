{
  "name": "navyaskitchen",
  "private": true,
  "scripts": {
    "lint": "eslint app.js config.js && htmlhint index.html policies.html",
    "lint:fix": "eslint app.js config.js --fix",
    "build": "echo 'Static site — no build step required' && npm run lint",
    "screenshots": "playwright test",
    "screenshots:desktop": "playwright test --project=desktop",
    "screenshots:mobile": "playwright test --project=mobile",
    "audit": "playwright test --config=playwright.audit.config.js",
    "audit:chromium": "playwright test --config=playwright.audit.config.js --project=chromium-desktop --project=report",
    "audit:report": "playwright test --config=playwright.audit.config.js --project=report",
    "audit:clean": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('tests','audit-report');if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true});console.log('cleaned',d);\"",
    "fonts:download": "node tests/global-setup.js"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^8.57.0",
    "htmlhint": "^1.1.4",
    "http-server": "^14.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
